' Block diagram for the device registry API.
'
' PlantUML source. IntelliJ renders this with the PlantUML plugin. README.md embeds the
' exported PNG, so re-export after any change:
'   docker run --rm -v "$PWD:/work" -w /work plantuml/plantuml -tpng -o images docs/*.puml
'
' The diagram id below is the export filename, so it must keep matching the path the
' README references.

@startuml architecture-diag
title Device registry API: one process, one database

skinparam componentStyle rectangle
skinparam shadowing false
top to bottom direction

actor "Client" as client

package "device-registry-api — Spring Boot, :8080" as app {

    package "device" as device {
        [DeviceController\n/api/v1/devices\nHTTP and nothing else] as controller
        [dto\nrequest and response models] as dto
        [DeviceService\n@Transactional\norchestration] as service
        [Device (entity)\nowns rules 1 and 2\n@Version] as entity
        [DeviceRepository\nSpring Data JPA] as repository
    }

    package "common — cross-cutting" as common {
        [GlobalExceptionHandler\n@RestControllerAdvice] as advice
        [PageResponse\npaged collection envelope] as page
        [OpenApiConfig + springdoc\n/v3/api-docs, /swagger-ui.html] as openapi
        [Actuator\n/actuator/health] as actuator
    }

    [Hibernate] as hibernate
    [Flyway\nclasspath:db/migration] as flyway
}

database "PostgreSQL 18" as db {
    [device\nid, name, brand, state,\ncreation_time, version] as table
    [indexes\nupper(brand)+state · state\n(creation_time DESC, id DESC)] as indexes
}

client --> controller : HTTP, application/json
client --> openapi : reads the spec,\ngenerated from the controller
client --> actuator : liveness / readiness

controller ..> dto : binds, validates,\nmaps entity to response
controller ..> page : wraps a page
controller --> service : id + request record
controller ..> advice : exceptions leave here

service --> entity : rename(), changeState()
service --> repository : find, save, delete
repository --> hibernate
hibernate --> db : JDBC\nthe version is in the WHERE clause\nof every update and delete
flyway --> db : migrates at startup

note right of entity
    Rules 1 and 2 are enforced here rather than in
    the service, so no caller can route around them.
    Rule 3 guards a delete, which is not a transition
    on the entity, so it sits in DeviceService.
end note

note right of advice
    One error contract: every domain and
    locking failure becomes problem+json.
end note

note bottom of app
    A single stateless process. The database is the only shared state,
    which is what the optimistic locking in the sequence diagram protects.
end note
@enduml
